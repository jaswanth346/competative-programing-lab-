#include <iostream>
#include <climits>
using namespace std;

int divide(int dividend, int divisor) {
    if (dividend == INT_MIN && divisor == -1) {
        return INT_MAX;
    }
    bool negative = (dividend < 0) ^ (divisor < 0);
    long long a = dividend;
    long long b = divisor;
    if (a < 0)
        a = -a;
    if (b < 0)
        b = -b;
    long long quotient = 0;
    while (a >= b) {
        long long value = b;
        long long multiple = 1;
        while ((value << 1) <= a) {
            value = value << 1;
            multiple = multiple << 1;
        }
        a = a - value;
        quotient = quotient + multiple;
    }
    if (negative)
        quotient = -quotient;
    return (int)quotient;
}
int main() {
    int dividend, divisor;
    cin >> dividend;
    cin >> divisor;
    cout << divide(dividend, divisor);
    return 0;
}
