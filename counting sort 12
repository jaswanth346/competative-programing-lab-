#include <iostream>
#include <vector>
using namespace std;

void countingSort(vector<int> &arr) {
    vector<int> frequency(100, 0);

    for(int i = 0; i < arr.size(); i++) {
        frequency[arr[i]]++;
    }

    for(int i = 0; i < 100; i++) {
        while(frequency[i] > 0) {
            cout << i << " ";
            frequency[i]--;
        }
    }
}

int main() {
    int n;
    cin >> n;

    vector<int> arr(n);

    for(int i = 0; i < n; i++) {
        cin >> arr[i];

        if(arr[i] < 0 || arr[i] > 99) {
            cout << "Error: Array elements must be between 0 and 99.";
            return 0;
        }
    }

    countingSort(arr);

    return 0;
}
