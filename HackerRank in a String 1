#include <iostream>
#include <string>
using namespace std;

int main() {
    string s;
    cin >> s;
    string target = "hackerrank";
    int j = 0;
    for (char ch : s) {
        if (j < target.length() && ch == target[j]) {
            j++;
        }
    }
    if (j == target.length()) {
        cout << "YES" << endl;
    } else {
        cout << "NO" << endl;
    }
    return 0;
}
