#include <cmath>
#include <cstdio>
#include <vector>
#include <iostream>
#include <algorithm>
using namespace std;

int main() {
    unsigned long long N;
    cin >> N;
    int count = 0;
    while (N > 0) {
        if (N & 1) {
            count++;
        }
        N = N >> 1;
    }
    cout << count;
    return 0;
}
