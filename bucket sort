#include <iostream>
#include <vector>
#include <algorithm>
#include <iomanip>
using namespace std;

int main() {
    int n;
    cin >> n;
    vector<double> arr(n);
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }
    double minValue = arr[0];
    double maxValue = arr[0];
    for (int i = 1; i < n; i++) {
        if (arr[i] < minValue)
            minValue = arr[i];
        if (arr[i] > maxValue)
            maxValue = arr[i];
    }
    vector<vector<double>> buckets(n);
    for (int i = 0; i < n; i++) {
        int index;
        if (maxValue == minValue) {
            index = 0;
        }
        else {
            index = (arr[i] - minValue) * n / (maxValue - minValue);
            if (index == n)
                index = n - 1;
        }
        buckets[index].push_back(arr[i]);
    }
    for (int i = 0; i < n; i++) {
        sort(buckets[i].begin(), buckets[i].end());
    }
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < buckets[i].size(); j++) {
            if (buckets[i][j] != (int)buckets[i][j])
                cout << fixed << setprecision(2)
                     << buckets[i][j];
            else
                cout << (int)buckets[i][j];
            cout << " ";
        }
    }
    return 0;
}
